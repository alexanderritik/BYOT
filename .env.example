# ============================================================
# STORAGE PROVIDER
# ============================================================

# Supported values:
#   minio
#   supabase

STORAGE_PROVIDER=minio


# ============================================================
# MINIO
# ============================================================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=byot
MINIO_REGION=us-east-1


# ============================================================
# SUPABASE STORAGE
# ============================================================

# IMPORTANT:
# Use the Supabase project URL here.
#
# Example:
# https://abcdefghijkl.supabase.co
#
# Do NOT put:
# /storage/v1
# /storage/v1/s3

SUPABASE_URL=https://your-project-ref.supabase.co

# This is your Supabase Storage API/service key.
# Keep it server-side.
SUPABASE_KEY=your-supabase-service-role-key

SUPABASE_BUCKET=byot


# ============================================================
# POSTGRESQL
# ============================================================

DB_URL=postgres://fnx:fnx@localhost:5432/fnx?sslmode=disable


# ============================================================
# DOCKER
# ============================================================

MAX_DOCKER_MEMORY_MB=2048
MAX_DOCKER_CPUS=4