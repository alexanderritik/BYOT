# ============================================================
# STORAGE PROVIDER
# ============================================================

# Supported values:
#   minio
#   supabase

STORAGE_PROVIDER=minio


# ============================================================
# MINIO
# ============================================================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=byot
MINIO_REGION=us-east-1


# ============================================================
# SUPABASE STORAGE
# ============================================================

# IMPORTANT:
# Use the Supabase project URL here.
#
# Example:
# https://abcdefghijkl.supabase.co
#
# Do NOT put:
# /storage/v1
# /storage/v1/s3

SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_...).
# Keep it server-side.
SUPABASE_KEY=your-supabase-service-role-key

SUPABASE_BUCKET=byot

# Supabase Auth: the public publishable key (sb_publishable_...), safe for
# browsers. Never put the secret key (sb_secret_...) here.
# When both SUPABASE_URL and this are set, uploading requires sign-in.
# Leave empty to disable auth (local dev).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx


# ============================================================
# POSTGRESQL
# ============================================================

DB_URL=postgres://fnx:fnx@localhost:5432/fnx?sslmode=disable


# ============================================================
# SECRETS
# ============================================================

# Encrypts per-test secret env vars at rest (AES-256-GCM).
# 32 random bytes, base64:  openssl rand -base64 32
# Back this up: losing it means losing every stored secret.
# Leave empty to disable secrets (plain variables still work).
SECRETS_KEY=


# ============================================================
# DOCKER
# ============================================================

# Jobs run in parallel on this instance. Size to your host: worst case is
# WORKER_CONCURRENCY x per-test memory/CPU (default 512m / 1 CPU each).
WORKER_CONCURRENCY=3

MAX_DOCKER_MEMORY_MB=2048
MAX_DOCKER_CPUS=4